PORT=5000
NODE_ENV=development

# ตัวเลือกที่ 1: ใส่ Connection String แบบเต็ม (สำหรับ Render Postgres / Supabase / Neon)
DATABASE_URL=

# ตัวเลือกที่ 2: กำหนดแยกตัวแปร (สำหรับ Local DB หรือ Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web_exam_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# URL ของ Frontend เพื่อตั้งค่า CORS
CLIENT_URL=http://localhost:5173

